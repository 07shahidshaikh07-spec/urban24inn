---
// First visit of the session only (home page). The sequence waits until the logo image has
// loaded (or 2.5 s at most), so the logo is always on screen when it plays:
// a gold line draws across, the logo rises from it, light crosses it, the four services
// arrive, then the doors open onto the page.
import Logo from './Logo.astro';
import type { Lang } from '../lib/site';
import { ui } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const verbs = ui[lang].verbs;
---
<div class="intro" aria-hidden="true" data-intro>
  <span class="intro__door intro__door--l"></span>
  <span class="intro__door intro__door--r"></span>
  <div class="intro__stage">
    <div class="intro__logo"><Logo variant="lockupLight" width={360} eager priority decorative /><span class="intro__shine"></span></div>
    <span class="intro__line"></span>
    <p class="intro__tag">{verbs.map((v, i) => <span style={`--i:${i}`}>{v}</span>)}</p>
  </div>
</div>
<script is:inline>
  (function () {
    var intro = document.querySelector('[data-intro]');
    if (!intro) return;
    var img = intro.querySelector('img');
    var go = function () { intro.classList.add('is-ready'); };
    if (!img || img.complete) return go();
    img.addEventListener('load', go, { once: true });
    img.addEventListener('error', go, { once: true });
    setTimeout(go, 2500);
  })();
</script>

<style>
  .intro { position: fixed; inset: 0; z-index: 150; pointer-events: none; animation: intro-gone 0.01s linear 3.7s both; }
  :global(.intro-seen) .intro { display: none; }
  /* Nothing moves until the logo is ready. */
  .intro:not(.is-ready), .intro:not(.is-ready) * { animation-play-state: paused !important; }
  .intro__door { position: absolute; top: 0; bottom: 0; width: 50.5%; background: radial-gradient(ellipse at 100% 50%, #202a0b, var(--esp-950) 70%); animation: 1.1s var(--ease-in-out) 2.75s both; }
  .intro__door--l { left: 0; animation-name: intro-door-l; }
  .intro__door--r { right: 0; background: radial-gradient(ellipse at 0% 50%, #202a0b, var(--esp-950) 70%); animation-name: intro-door-r; }
  .intro__stage { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 1.2rem; padding: 1rem; animation: intro-stage-out 0.7s var(--ease-in-out) 2.5s both; }
  .intro__logo { position: relative; overflow: hidden; clip-path: inset(100% 0 0 0); animation: intro-rise 1.3s var(--ease-out) 0.45s both; }
  .intro__logo :global(img) { display: block; width: min(360px, 74vw); height: auto; }
  .intro__shine { position: absolute; inset: 0; background: linear-gradient(105deg, transparent 38%, rgb(255 246 220 / 0.8) 50%, transparent 62%); transform: translateX(-120%); mix-blend-mode: overlay; animation: intro-shine 1.2s var(--ease-in-out) 1.35s both; }
  .intro__line { display: block; width: min(420px, 80vw); height: 1px; background: var(--metal); transform: scaleX(0); animation: intro-line 1s var(--ease-out) 0.05s both; }
  .intro__tag { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.1rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold-300); }
  :global(:lang(mr)) .intro__tag { letter-spacing: 0.05em; font-size: 0.95rem; text-transform: none; }
  .intro__tag span { opacity: 0; transform: translateY(12px); animation: intro-tag-in 0.7s var(--ease-out) calc(1.5s + var(--i) * 0.13s) both; }
  .intro__tag span + span::before { content: ''; display: inline-block; width: 5px; height: 5px; margin-inline-end: 1.1rem; border-radius: 50%; background: var(--gold-400); vertical-align: 0.2em; }
  @keyframes intro-line { to { transform: scaleX(1); } }
  @keyframes intro-rise { from { transform: translateY(40px); } to { clip-path: inset(0 0 0 0); transform: none; } }
  @keyframes intro-shine { to { transform: translateX(120%); } }
  @keyframes intro-tag-in { to { opacity: 1; transform: none; } }
  @keyframes intro-stage-out { to { opacity: 0; transform: scale(1.05); } }
  @keyframes intro-door-l { to { transform: translateX(-101%); } }
  @keyframes intro-door-r { to { transform: translateX(101%); } }
  @keyframes intro-gone { to { visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { .intro { display: none; } }
</style>
