---
// First visit of the session only (home page). Pure CSS, so it never waits for JavaScript:
// the logo rises from the ground, a gold light passes over it, the tagline arrives, the doors open.
import Logo from './Logo.astro';
import type { Lang } from '../lib/site';
import { ui } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const verbs = ui[lang].verbs;
---
<div class="intro" aria-hidden="true" data-intro>
  <span class="intro__door intro__door--l"></span>
  <span class="intro__door intro__door--r"></span>
  <div class="intro__stage">
    <div class="intro__logo"><Logo variant="lockupLight" width={320} eager decorative /></div>
    <p class="intro__tag">{verbs.map((v, i) => <span style={`--i:${i}`}>{v}</span>)}</p>
  </div>
</div>

<style>
  .intro { position: fixed; inset: 0; z-index: 150; pointer-events: none; animation: intro-gone 0.01s linear 3.15s both; }
  :global(.intro-seen) .intro { display: none; }
  .intro__door { position: absolute; top: 0; bottom: 0; width: 50.5%; background: var(--esp-950); animation: 1s var(--ease-in-out) 2.2s both; }
  .intro__door--l { left: 0; animation-name: door-l; }
  .intro__door--r { right: 0; animation-name: door-r; }
  .intro__stage { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 1.4rem; padding: 1rem; animation: stage-out 0.6s var(--ease-in-out) 1.95s both; }
  .intro__logo { position: relative; clip-path: inset(100% 0 0 0); animation: rise 1.25s var(--ease-out) 0.2s both; }
  .intro__logo :global(img) { width: min(320px, 70vw); height: auto; }
  .intro__logo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 35%, rgb(255 240 205 / 0.75) 50%, transparent 65%); background-size: 260% 100%; background-position: 120% 0; mix-blend-mode: overlay; animation: shine 1.1s var(--ease-in-out) 1.05s both; }
  .intro__tag { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.1rem; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold-300); }
  :global(:lang(mr)) .intro__tag { letter-spacing: 0.05em; font-size: 0.95rem; text-transform: none; }
  .intro__tag span { opacity: 0; transform: translateY(12px); animation: tag-in 0.7s var(--ease-out) calc(1.1s + var(--i) * 0.12s) both; }
  .intro__tag span + span::before { content: ''; display: inline-block; width: 5px; height: 5px; margin-inline-end: 1.1rem; border-radius: 50%; background: var(--gold-400); vertical-align: 0.2em; }
  @keyframes rise { to { clip-path: inset(0 0 0 0); } }
  @keyframes shine { to { background-position: -40% 0; } }
  @keyframes tag-in { to { opacity: 1; transform: none; } }
  @keyframes stage-out { to { opacity: 0; transform: scale(1.06); } }
  @keyframes door-l { to { transform: translateX(-101%); } }
  @keyframes door-r { to { transform: translateX(101%); } }
  @keyframes intro-gone { to { visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { .intro { display: none; } }
</style>
