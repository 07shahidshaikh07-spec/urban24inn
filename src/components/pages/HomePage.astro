---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Intro from '../Intro.astro';
import HeroPicture from '../HeroPicture.astro';
import Pic from '../Pic.astro';
import Icon from '../Icon.astro';
import Mark from '../Mark.astro';
import Logo from '../Logo.astro';
import Toran from '../Toran.astro';
import NightSky from '../NightSky.astro';
import CtaBand from '../CtaBand.astro';
import Visit from '../Visit.astro';
import { site, restaurant, rooms, banquet, href, tr, type Lang } from '../../lib/site';
import { photos, type PhotoId } from '../../lib/photos';
import { getHeroSources, HOME_HERO_SIZES } from '../../lib/hero';
import { graph, hotelLd, restaurantLd, banquetLd } from '../../lib/schema';
import { ui } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const h = t.home;
const base = Astro.site!;
const og = await getImage({ src: photos['facade-front'].src, width: 1200, format: 'jpg' });
const jsonLd = graph(hotelLd(base, new URL(og.src, base).href), restaurantLd(base), banquetLd(base));

// One photo per point, and no photo appears twice on this page:
// the building (hero), a room (Stay), the two room types, the dining room (Dine).
// The banquet hall and the rooftop have no photos yet, so they get illustrations, never a stand-in photo.
// The front of the building appears in Visit, on the map placeholder.
const HERO: PhotoId = 'building-portrait';
const hero = await getHeroSources(HERO);
// The client's order: restaurant, rooms, banquet hall, rooftop bar.
const doorLinks = [href('restaurant', lang), href('rooms', lang), href('banquet', lang), '#rooftop'];
const doorIcons = ['forkSpoon', 'bed', 'cheers', 'cocktail'] as const;
const roomCards: { room: (typeof rooms.rooms)[number]; photo: PhotoId }[] = [
  { room: rooms.rooms[0], photo: 'deluxe-premium-1' },
  { room: rooms.rooms[1], photo: 'luxury-1' },
];
const amenityIcon = (id: string) => (id === 'wifi' ? 'wifi' : id === 'ac' ? 'ac' : id === 'parking' ? 'car' : 'restaurant');
const ring = `${t.verbs.join(' · ')} · `;
---
<Base lang={lang} page="home" theme="home" title={t.meta.home.title} description={t.meta.home.description} jsonLd={jsonLd}>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={hero.avif} imagesizes={HOME_HERO_SIZES} fetchpriority="high" />
  <Intro lang={lang} />

  <!-- ============ Hero: the four verbs on a solid panel, the building in a gold arch ============ -->
  <section class="hero grain" data-hero aria-labelledby="hero-title">
    <span class="hero__glow" aria-hidden="true"></span>
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow hero__eyebrow">{h.hero.eyebrow}</p>
        <h1 id="hero-title" class="hero__title">
          <span class="sr-only">{h.hero.titleFull}</span>
          <span class="hero__line" aria-hidden="true">{h.hero.title}</span>
          <span class="hero__rot" aria-hidden="true"><span class="hero__typed" data-typed={JSON.stringify(h.hero.rotate)}>{h.hero.rotate[0]}</span><span class="hero__caret"></span></span>
        </h1>
        <p class="hero__lede">{h.hero.lede}</p>
        <div class="hero__ctas">
          <a class="btn btn--gold" href="#doors" data-magnetic>{h.hero.cta1}<Icon name="arrowDown" /></a>
          <a class="btn btn--ghost hero__ghost" href="#visit">{h.hero.cta2}</a>
        </div>
      </div>

      <figure class="hero__media">
        <span class="hero__outline" aria-hidden="true"></span>
        <div class="hero__arch" data-hero-arch>
          <HeroPicture id={HERO} lang={lang} sizes={HOME_HERO_SIZES} />
        </div>
        <svg class="hero__badge" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="hero-ring" d="M100 100m-74 0a74 74 0 1 1 148 0a74 74 0 1 1-148 0" /></defs>
          <circle class="hero__badge-bg" cx="100" cy="100" r="99" />
          <circle class="hero__badge-line" cx="100" cy="100" r="91" />
          <circle class="hero__badge-line" cx="100" cy="100" r="57" />
          <g class="hero__ring"><text class="hero__badge-text"><textPath href="#hero-ring" textLength="462" lengthAdjust="spacing">{ring}</textPath></text></g>
          <text class="hero__badge-24" x="100" y="115" text-anchor="middle">24</text>
        </svg>
        <figcaption class="hero__cap">{h.hero.caption}</figcaption>
      </figure>
    </div>
  </section>
  <!-- ============ Four doors: the whole building at a glance ============ -->
  <nav id="doors" class="wrap doors" aria-label={h.hero.doors}>
    <ul class="doors__list" role="list">
      {h.services.map((s, i) => (
        <li>
          <a class="door" href={doorLinks[i]} style={`--i:${i}`}>
            <span class="door__icon"><Icon name={doorIcons[i]} /></span>
            <span class="door__verb">{s.verb}</span>
            <span class="door__name">{s.name}{i === 3 && <span class="door__soon">{t.nav.soon}</span>}</span>
            <span class="door__go"><Icon name="arrowUpRight" /></span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- ============ One address ============ -->
  <section class="stmt pad" aria-labelledby="stmt-title">
    <span class="stmt__24" aria-hidden="true">24</span>
    <div class="wrap stmt__grid">
      <div class="stmt__copy">
        <span class="stmt__mark" aria-hidden="true"><Logo variant="markDark" width={150} decorative /></span>
        <p class="eyebrow">{h.intro.eyebrow}</p>
        <h2 id="stmt-title" class="stmt__title" data-fill>{h.intro.title}</h2>
        <p class="lede stmt__text">{h.intro.text}</p>
      </div>
      <!-- The building, floor by floor: roof at the top, restaurant on the ground, like the logo's towers -->
      <nav class="stack" aria-label={h.intro.stack}>
        <ol class="stack__list" role="list" data-rise>
          {[3, 1, 2, 0].map((i) => (
            <li class:list={['stack__lvl', `stack__lvl--${i}`]}>
              <a href={doorLinks[i]}>
                <span class="stack__icon"><Icon name={doorIcons[i]} /></span>
                <span class="stack__txt">
                  <span class="stack__floor">{h.intro.levels[i]}</span>
                  <span class="stack__name">{h.services[i].name}{i === 3 && <span class="stack__soon">{t.nav.soon}</span>}</span>
                </span>
                <span class="stack__go"><Icon name="arrowUpRight" /></span>
              </a>
            </li>
          ))}
        </ol>
        <span class="stack__base" aria-hidden="true"></span>
      </nav>
    </div>
  </section>

  <!-- ============ 01 Dine ============ -->
  <section id="dine" class="chap dine s-esp pad" aria-labelledby="dine-title">
    <div class="wrap chap__grid">
      <figure class="chap__photo chap__photo--wide" data-reveal="curtain" data-depth>
        <Pic id="dalchini-dining" lang={lang} sizes="(min-width: 960px) 50vw, 100vw" widths={[480, 800, 1200]} position="70% center" />
      </figure>
      <div class="chap__body">
        <p class="chap__tag"><span class="chap__no" data-draw><svg viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="21" pathLength="1" /></svg>01</span>{t.verbs[0]}</p>
        <h2 id="dine-title" class="h-1" data-split="words">{h.dining.title}</h2>
        <p class="lede">{h.dining.text}</p>
        <ul class="dishes" role="list">
          {restaurant.signatures.map((s) => (
            <li class="dishes__item">
              <Mark veg={s.veg} label={s.veg ? t.restaurant.menu.vegMark : t.restaurant.menu.nonvegMark} />
              <span class="dishes__names">
                <span class="dishes__mr" lang="mr">{s.name.mr}</span>
                {lang === 'en' && <span class="dishes__en">{s.name.en}</span>}
              </span>
            </li>
          ))}
        </ul>
        <a class="btn btn--gold" href={href('restaurant', lang, '#menu')} data-magnetic>{h.dining.cta}<Icon name="arrowRight" /></a>
      </div>
    </div>
  </section>

  <!-- ============ 02 Stay ============ -->
  <section id="stay" class="chap stay s-paper pad" aria-labelledby="stay-title">
    <div class="wrap chap__grid chap__grid--flip">
      <figure class="chap__photo chap__photo--tall" data-reveal="curtain" data-depth>
        <Pic id="luxury-3" lang={lang} sizes="(min-width: 960px) 44vw, 100vw" widths={[480, 800, 1200]} />
      </figure>
      <div class="chap__body">
        <p class="chap__tag"><span class="chap__no" data-draw><svg viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="21" pathLength="1" /></svg>02</span>{t.verbs[1]}</p>
        <h2 id="stay-title" class="h-1" data-split="words">{h.rooms.title}</h2>
        <p class="lede">{h.rooms.text}</p>
        <ul class="stay__rooms" role="list">
          {roomCards.map(({ room, photo }) => (
            <li>
              <a class="rc" href={href('rooms', lang, `#${room.id}`)} data-tilt data-cursor={h.rooms.view}>
                <span class="rc__img"><Pic id={photo} lang={lang} sizes="(min-width: 960px) 20vw, 46vw" widths={[360, 600, 900]} /></span>
                <span class="rc__name">{tr(room.name, lang)}</span>
                <span class="rc__meta"><Icon name="users" />{t.rooms.guests(room.guests)}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="stay__label">{h.amenities.eyebrow}</p>
        <ul class="stay__amn" role="list">
          {rooms.amenities.filter((a) => a.confirmed).map((a) => <li><Icon name={amenityIcon(a.id)} />{tr(a, lang)}</li>)}
        </ul>
        <div class="chap__ctas">
          <a class="btn btn--dark" href={href('rooms', lang)} data-magnetic>{h.rooms.all}<Icon name="arrowRight" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Marquee ============ -->
  <div class="tag s-esp-deep" aria-hidden="true" data-marquee>
    <div class="tag__track" data-marquee-track>
      {[0, 1].map(() => (
        <p class="tag__row">{[...t.verbs, ...t.verbs].map((v) => <span class="tag__item">{v}<i></i></span>)}</p>
      ))}
    </div>
  </div>

  <!-- ============ 03 Celebrate (no hall photos yet: an illustrated toran, not a stand-in photo) ============ -->
  <section id="celebrate" class="chap cel" aria-labelledby="cel-title">
    <Toran class="cel__toran" />
    <div class="wrap cel__in">
      <span class="cel__arch" aria-hidden="true"></span>
      <p class="chap__tag"><span class="chap__no" data-draw><svg viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="21" pathLength="1" /></svg>03</span>{t.verbs[2]}</p>
      <h2 id="cel-title" class="h-display cel__title" data-split="words">{h.banquet.title}</h2>
      <p class="lede cel__text">{h.banquet.text}</p>
      <p class="cel__occ">{tr(banquet.occasions.value, lang)}</p>
      <a class="btn btn--dark" href={href('banquet', lang)} data-magnetic>{h.banquet.cta}<Icon name="arrowRight" /></a>
    </div>
  </section>

  <!-- ============ 04 Unwind: rooftop bar, coming soon (a representative photo until it opens) ============ -->
  <section id="rooftop" class="chap roof s-night" aria-labelledby="roof-title">
    <NightSky />
    <div class="wrap roof__in">
      <div class="roof__text">
        <p class="chap__tag"><span class="chap__no" data-draw><svg viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="21" pathLength="1" /></svg>04</span>{t.verbs[3]}<span class="roof__soon"><span class="roof__pulse" aria-hidden="true"></span>{h.rooftop.eyebrow}</span></p>
        <h2 id="roof-title" class="h-1" data-split="words">{h.rooftop.title}</h2>
        <p class="lede">{h.rooftop.text}</p>
        <a class="btn btn--ghost" href={site.links.instagram} target="_blank" rel="noopener"><Icon name="instagram" />{h.rooftop.cta}</a>
      </div>
      <figure class="chap__photo chap__photo--wide roof__photo" data-reveal="curtain" data-depth>
        <Pic id="rooftop-placeholder" lang={lang} sizes="(min-width: 960px) 44vw, 100vw" widths={[480, 800, 1200]} />
        <figcaption class="roof__note">{h.rooftop.photoNote}</figcaption>
      </figure>
    </div>
  </section>

  <CtaBand lang={lang} />
  <Visit lang={lang} variant="home" />
</Base>

<style>
  /* ---------- Hero: text never sits on a photo ---------- */
  .hero { --d: 0.1s; position: relative; padding-block: calc(var(--hdr-h) + clamp(1.75rem, 5vh, 4rem)) clamp(6.5rem, 12vh, 8.5rem); background: radial-gradient(60% 55% at 88% 12%, rgb(238 211 154 / 0.6), transparent 70%), radial-gradient(45% 45% at 5% 95%, rgb(232 150 46 / 0.12), transparent 70%), linear-gradient(180deg, #fffaf1 0%, #f6e9d4 100%); color: var(--esp-900); overflow: hidden; isolation: isolate; }
  :global(html:not(.intro-seen)) .hero { --d: 3.1s; }
  .hero__glow { position: absolute; z-index: -1; top: -30vw; right: -25vw; width: 90vw; height: 90vw; max-width: 1100px; max-height: 1100px; background: radial-gradient(circle, rgb(212 164 82 / 0.16), transparent 62%); pointer-events: none; }
  .hero__grid { display: grid; gap: clamp(3rem, 7vw, 5rem); align-items: center; }
  .hero__text { display: grid; gap: 1.6rem; justify-items: start; }
  .hero__eyebrow { --accent: var(--gold-700); }
  .hero__title { margin: 0; display: grid; font-family: var(--font-display); font-weight: 400; font-size: clamp(3.1rem, 1.7rem + 5.4vw, 6.6rem); line-height: 1.02; letter-spacing: -0.012em; }
  :global(:lang(mr)) .hero__title { font-family: var(--font-mr); font-size: clamp(2.7rem, 1.6rem + 4.4vw, 5.4rem); line-height: 1.26; letter-spacing: 0; }
  .hero__line { display: block; color: var(--esp-900); }
  /* The second line is typed: scripts/home.ts types each phrase, pauses, deletes it and types the next.
     Only one phrase is ever on the line, and the line keeps its height while empty. */
  .hero__rot { display: block; min-height: 1.06em; color: #8a5a1c; white-space: nowrap; }
  :global(:lang(mr)) .hero__rot { min-height: 1.26em; }
  .hero__caret { display: inline-block; width: 0.06em; min-width: 3px; height: 0.8em; margin-left: 0.08em; vertical-align: -0.02em; border-radius: 2px; background: var(--metal); animation: caret 1.05s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .hero__lede { max-width: 34ch; margin: 0; font-size: var(--step-1); line-height: 1.55; color: var(--esp-700); }
  :global(:lang(mr)) .hero__lede { line-height: 1.75; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero__ghost { --fg: var(--esp-900); --bg: var(--cream-50); }

  .hero__media { position: relative; justify-self: center; width: min(100%, 440px); margin: 0; padding: 18px 18px 0 0; }
  .hero__arch { position: relative; aspect-ratio: 4 / 5; border-radius: 50% 50% 26px 26px / 40% 40% 26px 26px; overflow: hidden; background: var(--esp-800); box-shadow: 0 50px 90px -40px rgb(62 34 20 / 0.5), 0 0 0 6px rgb(255 250 241 / 0.9); }
  .hero__arch :global(picture) { position: absolute; inset: -7% 0; display: block; }
  .hero__arch :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .hero__outline { position: absolute; inset: 0 0 18px 18px; border: 1.5px solid rgb(192 138 58 / 0.75); border-radius: 50% 50% 28px 28px / 40% 40% 28px 28px; pointer-events: none; }
  .hero__badge { position: absolute; z-index: 2; left: -14px; bottom: 54px; width: 118px; height: 118px; overflow: visible; }
  .hero__badge-bg { fill: var(--esp-900); }
  .hero__badge-line { fill: none; stroke: rgb(226 188 114 / 0.45); stroke-width: 1; }
  .hero__badge-text { fill: var(--gold-300); font: 600 15px/1 var(--font-text); letter-spacing: 0.16em; text-transform: uppercase; }
  :global(:lang(mr)) .hero__badge-text { font-size: 17px; letter-spacing: 0.02em; text-transform: none; }
  .hero__badge-24 { fill: var(--gold-200); font: 400 46px/1 var(--font-display); }
  .hero__ring { transform-box: view-box; transform-origin: 100px 100px; }
  .hero__cap { display: flex; align-items: center; gap: 0.75rem; margin-top: 1.1rem; font-size: 0.76rem; letter-spacing: 0.16em; text-transform: uppercase; color: #6e5240; }
  :global(:lang(mr)) .hero__cap { font-size: 0.9rem; letter-spacing: 0.02em; text-transform: none; }
  .hero__cap::before { content: ''; width: 2.2rem; height: 1px; background: var(--metal-soft); }

  /* ---------- Four doors ---------- */
  .doors { --d: 0.1s; position: relative; z-index: 5; margin-top: -3.4rem; }
  :global(html:not(.intro-seen)) .doors { --d: 3.1s; }
  .doors__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0; margin: 0; list-style: none; overflow: hidden; border-radius: 22px; background: var(--cream-50); box-shadow: 0 30px 60px -28px rgb(23 12 6 / 0.6), 0 0 0 1px rgb(192 138 58 / 0.28); }
  .doors__list li { min-width: 0; }
  .doors__list li:nth-child(even) { border-left: 1px solid var(--line); }
  .doors__list li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  .door { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'icon go' 'verb verb' 'name name'; align-items: center; row-gap: 0.35rem; height: 100%; padding: 1.1rem 1rem 1.2rem; color: var(--esp-900); text-decoration: none; overflow: hidden; isolation: isolate; transition: color 0.45s var(--ease-out); }
  .door::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--esp-900); transform: translateY(101%); transition: transform 0.65s var(--ease-out); }
  .door::after { content: ''; position: absolute; left: 1rem; right: 1rem; bottom: 0; height: 2px; background: var(--metal); transform: scaleX(0); transform-origin: left; transition: transform 0.7s var(--ease-out) 0.1s; }
  .door:hover, .door:focus-visible { color: var(--cream-100); }
  .door:hover::before, .door:focus-visible::before { transform: none; }
  .door:hover::after, .door:focus-visible::after { transform: scaleX(1); }
  .door__icon { grid-area: icon; display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid rgb(192 138 58 / 0.45); border-radius: 50%; color: var(--gold-700); transition: transform 0.7s var(--ease-out), color 0.4s, border-color 0.4s; }
  .door__icon :global(svg) { width: 21px; height: 21px; }
  .door__verb { grid-area: verb; margin-top: 0.4rem; font-family: var(--font-display); font-size: var(--step-1); line-height: 1.1; }
  :global(:lang(mr)) .door__verb { font-family: var(--font-mr); line-height: 1.35; }
  .door__name { grid-area: name; display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); transition: color 0.4s; }
  :global(:lang(mr)) .door__name { font-size: 0.85rem; letter-spacing: 0.02em; text-transform: none; }
  .door__soon { padding: 0.05em 0.55em; border: 1px solid currentColor; border-radius: 999px; font-size: 0.62rem; letter-spacing: 0.08em; }
  .door__go { grid-area: go; justify-self: end; align-self: start; width: 20px; height: 20px; opacity: 0.5; transition: transform 0.5s var(--ease-out), opacity 0.4s; }
  .door:hover .door__icon, .door:focus-visible .door__icon { transform: rotate(-14deg) scale(1.08); color: var(--gold-300); border-color: rgb(226 188 114 / 0.6); }
  .door:hover .door__name, .door:focus-visible .door__name { color: #cdb9a3; }
  .door:hover .door__go, .door:focus-visible .door__go { transform: translate(3px, -3px); opacity: 1; }
  @media (min-width: 900px) {
    .doors__list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .doors__list li:nth-child(n + 3) { border-top: 0; }
    .doors__list li + li { border-left: 1px solid var(--line); }
    .door { padding: 1.5rem 1.4rem 1.6rem; }
    .door__verb { font-size: var(--step-2); }
  }

  @media (min-width: 960px) {
    .hero { display: grid; align-content: center; min-height: 100svh; }
    .hero__grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
    .hero__media { justify-self: end; width: min(100%, 460px); }
    .hero__badge { left: -62px; bottom: 96px; width: 148px; height: 148px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Transforms only, from the first frame: nothing waits on opacity, so the largest paint is never delayed. */
    :global(.motion) :is(.hero__eyebrow, .hero__lede, .hero__ctas) { animation: rise 1.2s var(--ease-out) calc(var(--d) + 0.35s) both; }
    :global(.motion) .hero__line { animation: rise 1.25s var(--ease-out) var(--d) both; }
    :global(.motion) .hero__rot { animation: rise 1.25s var(--ease-out) calc(var(--d) + 0.1s) both; }
    :global(.motion) .hero__arch { animation: rise-far 1.5s var(--ease-out) var(--d) both; }
    :global(.motion) .hero__arch :global(img) { animation: settle 2.8s var(--ease-out) var(--d) both; }
    :global(.motion) .hero__outline { animation: outline-in 1.6s var(--ease-out) calc(var(--d) + 0.3s) both; }
    :global(.motion) .hero__badge { animation: badge-in 1.4s var(--ease-out) calc(var(--d) + 0.55s) both; }
    :global(.motion) .hero__ring { animation: spin 30s linear infinite; animation-play-state: paused; }
    :global(.motion.deco-live) .hero__ring { animation-play-state: running; }
    :global(.motion) .door { animation: rise 1.2s var(--ease-out) calc(var(--d) + 0.5s + var(--i) * 0.08s) both; }
  }
  @keyframes rise { from { transform: translateY(28px); } }
  @keyframes rise-far { from { transform: translateY(70px); } }
  @keyframes settle { from { transform: scale(1.16); } }
  @keyframes outline-in { from { opacity: 0; transform: translate(-18px, 18px); } }
  @keyframes badge-in { from { transform: scale(0.6) rotate(-40deg); } }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ---------- One address: the statement, and the building floor by floor ---------- */
  .stmt { position: relative; overflow: hidden; isolation: isolate; background: radial-gradient(50% 60% at 100% 40%, rgb(238 211 154 / 0.45), transparent 70%), linear-gradient(180deg, #fbf4e8, #f6ead7); color: var(--esp-700); }
  .stmt__24 { position: absolute; z-index: -1; left: -2vw; bottom: -12vw; font-family: var(--font-display); font-size: clamp(16rem, 34vw, 34rem); line-height: 1; color: rgb(192 138 58 / 0.08); pointer-events: none; user-select: none; }
  .stmt__grid { display: grid; gap: clamp(3rem, 7vw, 6rem); align-items: center; }
