---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import BookingBar from '../BookingBar.astro';
import SectionHead from '../SectionHead.astro';
import Pic from '../Pic.astro';
import Icon from '../Icon.astro';
import Tbc from '../Tbc.astro';
import DraftBlock from '../DraftBlock.astro';
import CtaBand from '../CtaBand.astro';
import Visit from '../Visit.astro';
import { rooms, site, show, tr, fmtTime, type Lang } from '../../lib/site';
import { photos, type PhotoId } from '../../lib/photos';
import { getHeroSources, PAGE_HERO_SIZES } from '../../lib/hero';
import { graph, hotelLd } from '../../lib/schema';
import { ui } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const r = t.rooms;
const base = Astro.site!;
const img = await getImage({ src: photos['deluxe-premium-1'].src, width: 1200, format: 'jpg' });
const jsonLd = graph(hotelLd(base, new URL(img.src, base).href));
// The hero shows one Luxury Room photo; the galleries leave it out, so no photo appears twice on this page.
const HERO: PhotoId = 'luxury-1';
const hero = await getHeroSources(HERO);
const galleryOf = (room: (typeof rooms.rooms)[number]) => (room.photos as PhotoId[]).filter((p) => p !== HERO);
const icons: Record<string, Parameters<typeof Icon>[0]['name']> = {
  wifi: 'wifi', ac: 'ac', parking: 'car', restaurant: 'restaurant', lift: 'lift', housekeeping: 'housekeeping', laundry: 'laundry', tv: 'tv', desk: 'desk', transfer: 'transfer',
};
const dials = [
  { label: r.times.checkin, word: r.times.from, fact: rooms.checkIn },
  { label: r.times.checkout, word: r.times.by, fact: rooms.checkOut },
];
---
<Base lang={lang} page="rooms" theme="rooms" title={t.meta.rooms.title} description={t.meta.rooms.description} ogPhoto="deluxe-premium-1" jsonLd={jsonLd}>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={hero.avif} imagesizes={PAGE_HERO_SIZES} fetchpriority="high" />
  <PageHero lang={lang} photo={HERO} eyebrow={r.hero.eyebrow} title={r.hero.title} lede={r.hero.lede} position="center 55%">
    <div slot="after" class="wrap rp__bk"><BookingBar lang={lang} id="rooms-bk" /></div>
  </PageHero>

  <!-- ---------- Rooms ---------- -->
  <section id="rooms" class="rl s-cream grain pad" aria-labelledby="rl-title">
    <div class="wrap">
      <SectionHead id="rl-title" eyebrow={r.list.eyebrow} title={r.list.title} text={r.list.text} />
      {rooms.rooms.map((room, ri) => (
        <article class:list={['room', ri % 2 && 'room--flip']} id={room.id} aria-labelledby={`${room.id}-name`}>
          <div class="room__gallery" data-gallery>
            <div class="room__track" data-track tabindex="0" aria-label={`${tr(room.name, lang)}: ${lang === 'en' ? 'photos' : 'फोटो'}`} data-lenis-prevent>
              {galleryOf(room).map((pid, i) => (
                <figure class="room__slide" data-reveal={i === 0 ? 'curtain' : undefined}>
                  <Pic id={pid} lang={lang} sizes="(min-width: 900px) 58vw, 100vw" widths={[480, 800, 1200]} />
                </figure>
              ))}
            </div>
            {galleryOf(room).length > 1 && (
              <div class="room__bar">
                <button type="button" class="arrow-dot room__btn" data-prev aria-label={r.prev}><Icon name="chevronLeft" /></button>
                <span class="room__pos" data-pos data-template={r.position(0, 0).replace('0', '{i}').replace('0', '{n}')} aria-live="polite">{r.position(1, galleryOf(room).length)}</span>
                <span class="room__prog" aria-hidden="true"><span data-prog></span></span>
                <button type="button" class="arrow-dot room__btn" data-next aria-label={r.next}><Icon name="chevronRight" /></button>
              </div>
            )}
          </div>
          <div class="room__body">
            <span class="room__no">{String(ri + 1).padStart(2, '0')}</span>
            <h3 class="room__name" id={`${room.id}-name`} data-split="lines">{tr(room.name, lang)}</h3>
            <p class="room__guests"><Icon name="users" />{r.guests(room.guests)}</p>
            <p class="room__note">{tr(room.note, lang)}</p>
            {show(room.details) && (
              <DraftBlock confirmed={room.details.confirmed} lang={lang} note={room.details.source} class="room__details">
                <ul role="list">{room.details.items.map((it) => <li>{tr(it, lang)}</li>)}</ul>
              </DraftBlock>
            )}
            <a class="btn btn--dark" href={site.links.booking} target="_blank" rel="noopener" data-magnetic>{r.check}<Icon name="arrowUpRight" /></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ---------- Amenities ---------- -->
  <section class="am s-esp pad" aria-labelledby="am-title">
    <div class="wrap">
      <SectionHead id="am-title" eyebrow={r.amenities.eyebrow} title={r.amenities.title} />
      <ul class="am__grid" role="list" data-rise>
        {rooms.amenities.filter((a) => show(a)).map((a) => (
          <li class="am__item">
            <span class="am__ic"><Icon name={icons[a.id] ?? 'sparkle'} /></span>
            <span>{tr(a, lang)}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ---------- Meal plans: a lift panel ---------- -->
  <section class="pl s-cream pad" aria-labelledby="pl-title">
    <div class="wrap pl__grid">
      <SectionHead id="pl-title" eyebrow={r.plans.eyebrow} title={r.plans.title} text={r.plans.text} />
      <dl class="pl__list" data-rise>
        {rooms.plans.map((p) => (
          <div class="plan">
            <dt><span class="plan__btn" aria-hidden="true">{p.code === 'Standard' ? 'S' : p.code}</span><span class="plan__name">{tr(p.name, lang)}{p.code !== 'Standard' && <span class="plan__code"> ({p.code})</span>}</span></dt>
            <dd>{tr(p.text, lang)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ---------- Times ---------- -->
  <section class="tm s-esp-deep pad" aria-labelledby="tm-title">
    <div class="wrap">
      <SectionHead id="tm-title" eyebrow={r.times.eyebrow} title={r.times.title} align="center" />
      <div class="tm__grid">
        {dials.filter((x) => show(x.fact)).map((x) => (
          <DraftBlock confirmed={x.fact.confirmed} lang={lang} note={x.fact.source}>
            <div class="dial" data-dial data-time={x.fact.value}>
              <svg viewBox="0 0 200 200" aria-hidden="true">
                <circle cx="100" cy="100" r="92" fill="none" stroke="#f3c45a" stroke-opacity=".35" stroke-width="1.5" />
                <circle cx="100" cy="100" r="80" fill="none" stroke="#f3c45a" stroke-opacity=".12" stroke-width="10" />
                {Array.from({ length: 12 }, (_, i) => (
                  <rect class="dial__tick" x="98.6" y="14" width="2.8" height={i % 3 === 0 ? 16 : 8} rx="1.4" fill="#f3c45a" fill-opacity={i % 3 === 0 ? 0.95 : 0.5} transform={`rotate(${i * 30} 100 100)`} />
                ))}
                <line data-hand="h" x1="100" y1="100" x2="100" y2="54" stroke="#eaa91c" stroke-width="6" stroke-linecap="round" />
                <line data-hand="m" x1="100" y1="100" x2="100" y2="28" stroke="#fcf8ed" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="100" cy="100" r="6" fill="#eaa91c" />
              </svg>
              <p class="dial__label">{x.label}</p>
              <p class="dial__time">{fmtTime(x.fact.value, lang)}</p>
              <p class="dial__word">{x.word}</p>
            </div>
          </DraftBlock>
        ))}
      </div>
      {show(rooms.frontDesk) && (
        <p class="tm__desk"><Tbc confirmed={rooms.frontDesk.confirmed} lang={lang} note={rooms.frontDesk.source}>{tr(rooms.frontDesk.value, lang)}</Tbc></p>
      )}
    </div>
  </section>

  <!-- ---------- Bathrooms ---------- -->
  <section class="bt s-cream pad" aria-labelledby="bt-title">
    <div class="wrap bt__grid">
      <SectionHead id="bt-title" eyebrow={r.baths.eyebrow} title={r.baths.title} text={r.baths.text} />
      <figure class="bt__a" data-reveal="curtain"><Pic id="bath-1" lang={lang} sizes="(min-width: 900px) 30vw, 60vw" widths={[400, 700, 1000]} /></figure>
      <figure class="bt__b" data-parallax="14"><Pic id="bath-2" lang={lang} sizes="(min-width: 900px) 26vw, 50vw" widths={[400, 700, 1000]} /></figure>
    </div>
  </section>

  <!-- ---------- FAQ ---------- -->
  <section class="fq s-ivory pad" aria-labelledby="fq-title">
    <div class="wrap fq__grid">
      <SectionHead id="fq-title" eyebrow={r.faq.eyebrow} title={r.faq.title} />
      <div class="fq__list">
        {rooms.faq.filter((f) => show(f)).map((f) => (
          <details class="fq__item" data-acc>
            <summary>{tr(f.q, lang)}<span class="fq__icon" aria-hidden="true"></span></summary>
            <div class="fq__a" data-acc-body><p>{tr(f.a, lang)}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
  <Visit lang={lang} variant="rooms" />
</Base>

<style>
  .rp__bk { position: relative; z-index: 3; margin-top: 2rem; }

  /* Rooms */
  .room { display: grid; gap: 1.75rem; margin-top: clamp(3rem, 7vw, 5.5rem); }
  .room__gallery { position: relative; min-width: 0; }
  .room__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: var(--radius); cursor: grab; }
  .room__track::-webkit-scrollbar { display: none; }
  .room__track:global(.is-drag) { scroll-snap-type: none; cursor: grabbing; user-select: none; }
  .room__slide { position: relative; flex: 0 0 100%; aspect-ratio: 16 / 11; overflow: hidden; scroll-snap-align: start; }
  .room__slide :global(img) { pointer-events: none; }
  .room__bar { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.9rem; }
  .room__btn { background: none; color: var(--esp-700); }
  .room__btn:hover { background: var(--esp-900); color: var(--gold-300); }
  .room__btn[aria-disabled='true'] { opacity: 0.35; }
  .room__pos { min-width: 8ch; font-size: var(--step--1); color: var(--muted); }
  .room__prog { flex: 1; height: 2px; background: var(--line); }
  .room__prog span { display: block; height: 100%; background: var(--metal); transform-origin: left; transform: scaleX(0.25); transition: transform 0.6s var(--ease-out); }
  .room__body { display: grid; gap: 1rem; justify-items: start; align-content: center; }
  .room__no { font-family: var(--font-display); font-size: 1.1rem; color: var(--gold-700); }
  .room__name { font-family: var(--font-display); font-weight: 400; font-size: var(--step-3); line-height: 1.05; }
  :global(:lang(mr)) .room__name { font-family: var(--font-mr); line-height: 1.3; }
  .room__guests { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--gold-700); }
  .room__guests :global(svg) { width: 20px; height: 20px; }
  .room__note { max-width: 42ch; color: var(--muted); }
  .room__body :global(.room__details) { width: 100%; }
  .room__body :global(.room__details) ul { display: grid; gap: 0.4rem; padding: 0 0 0 1.1rem; margin: 0; }
  @media (min-width: 900px) {
    .room { grid-template-columns: 7fr 4fr; align-items: center; column-gap: clamp(2rem, 5vw, 5rem); }
    .room--flip { grid-template-columns: 4fr 7fr; }
    .room--flip .room__gallery { order: 2; }
  }

  /* Amenities */
  .am__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 1px; margin-top: clamp(2rem, 5vw, 3rem); padding: 0; list-style: none; background: var(--line); border-radius: var(--radius); overflow: hidden; }
  .am__item { display: flex; align-items: center; gap: 1rem; padding: 1.4rem 1.25rem; background: var(--esp-900); font-size: var(--step-0); transition: background-color 0.4s; }
  .am__item:hover { background: var(--esp-800); }
  .am__ic { display: grid; place-items: center; width: 48px; height: 48px; flex: none; border-radius: 50%; border: 1px solid rgb(243 196 90 / 0.45); color: var(--gold-300); }
  .am__ic :global(svg) { width: 22px; height: 22px; }

  /* Plans */
  .pl__grid { display: grid; gap: clamp(2rem, 5vw, 4rem); }
  .pl__list { display: grid; gap: 0.25rem; }
  .plan { display: grid; grid-template-columns: auto 1fr; gap: 0.2rem 1.1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  .plan dt { display: contents; }
  .plan__btn { grid-row: span 2; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; border: 1.5px solid var(--gold-500); font-weight: 600; font-size: 0.9rem; color: var(--gold-700); transition: background-color 0.35s, color 0.35s, box-shadow 0.35s; }
  .plan:hover .plan__btn { background: var(--metal-soft); color: var(--esp-900); box-shadow: 0 0 0 6px rgb(234 169 28 / 0.18), 0 0 26px rgb(234 169 28 / 0.5); }
  .plan__name { font-size: var(--step-1); font-weight: 600; align-self: end; }
  .plan__code { font-weight: 400; color: var(--muted); }
  .plan dd { color: var(--muted); }
  @media (min-width: 900px) { .pl__grid { grid-template-columns: 1fr 1.1fr; align-items: center; } }

  /* Times */
  .tm__grid { display: grid; gap: 3rem; margin-top: clamp(2rem, 5vw, 3.5rem); }
  .dial { display: grid; justify-items: center; text-align: center; gap: 0.25rem; }
  .dial svg { width: min(64vw, 250px); margin-bottom: 1rem; }
  .dial__label { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-300); }
  :global(:lang(mr)) .dial__label { letter-spacing: 0.02em; font-size: 0.95rem; text-transform: none; }
  .dial__time { font-family: var(--font-display); font-size: var(--step-4); line-height: 1.05; }
  :global(:lang(mr)) .dial__time { font-family: var(--font-mr); }
  .dial__word { color: var(--muted); }
  .tm__desk { margin-top: 2.5rem; text-align: center; font-size: var(--step-1); }
  @media (min-width: 700px) { .tm__grid { grid-template-columns: 1fr 1fr; } }

  /* Bathrooms */
  .bt__grid { display: grid; gap: 1.5rem; grid-template-columns: 1fr 1fr; align-items: start; }
  .bt__grid > :global(.shd) { grid-column: 1 / -1; }
  .bt__a, .bt__b { position: relative; overflow: hidden; aspect-ratio: 3 / 4; border-radius: var(--radius); }
  .bt__b { margin-top: 4rem; }
  @media (min-width: 900px) {
    .bt__grid { grid-template-columns: 1.1fr 1fr 1fr; column-gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
    .bt__grid > :global(.shd) { grid-column: 1; }
    .bt__b { margin-top: 9rem; }
  }

  /* FAQ */
  .fq__grid { display: grid; gap: 2rem; }
  .fq__list { border-top: 1px solid var(--line); }
  .fq__item { border-bottom: 1px solid var(--line); }
  .fq__item summary { position: relative; display: flex; align-items: center; gap: 0.6rem; min-height: 64px; padding: 1rem 3rem 1rem 0; font-size: var(--step-1); font-weight: 600; list-style: none; cursor: pointer; }
  .fq__item summary::-webkit-details-marker { display: none; }
  .fq__icon { position: absolute; right: 0.5rem; top: 50%; width: 18px; height: 18px; translate: 0 -50%; }
  .fq__icon::before, .fq__icon::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--gold-700); transition: transform 0.45s var(--ease-out); }
  .fq__icon::after { transform: rotate(90deg); }
  .fq__item[open] .fq__icon::after { transform: rotate(0deg); }
  .fq__a { overflow: hidden; }
  .fq__a p { padding: 0 0 1.25rem; max-width: 60ch; color: var(--muted); }
  @media (min-width: 900px) { .fq__grid { grid-template-columns: 1fr 2fr; } }
</style>
