---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
import { ui } from '../i18n/ui';
const t = ui.en;
const m = ui.mr;
---
<Base lang="en" page="other" theme="home" title={t.meta.notFound.title} description={t.meta.notFound.description} noindex>
  <section class="nf s-esp-deep">
    <div class="wrap nf__in">
      <p class="nf__mr" lang="mr">{m.notFound.title}</p>
      <h1 class="nf__title">{t.notFound.title}</h1>
      <p class="lede">{t.notFound.text}</p>
      <ul class="nf__links" role="list">
        <li><a class="btn btn--gold" href={href('rooms', 'en')}>{t.nav.rooms}</a></li>
        <li><a class="btn btn--ghost" href={href('restaurant', 'en')}>{t.nav.restaurant}</a></li>
        <li><a class="btn btn--ghost" href={href('home', 'en')}>{t.nav.home}</a></li>
        <li><a class="btn btn--ghost" href={href('home', 'mr')} lang="mr">{m.nav.home}</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 100svh; display: grid; align-items: center; padding-block: calc(var(--hdr-h) + 3rem) 4rem; }
  .nf__in { display: grid; gap: 1.25rem; justify-items: start; }
  .nf__mr { font-family: var(--font-mr); font-size: var(--step-2); color: var(--gold-300); }
  .nf__title { font-family: var(--font-display); font-weight: 400; font-size: var(--step-5); line-height: 0.95; letter-spacing: -0.04em; }
  .nf__links { display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 0; margin-top: 1rem; }
</style>
